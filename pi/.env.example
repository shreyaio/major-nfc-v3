# pi/.env — ARCHITECTURE.md §21.2
#
# Copy to pi/.env on the Raspberry Pi and fill in. NEVER COMMIT THE REAL FILE.
#
# NOTE WHAT IS NOT HERE. The Pi holds no decryption key, no TAG_INDEX_KEY and no
# admin signing key. In v1, one cheap Linux box held both the signing key and the
# key that decrypted every record in the database — compromising it broke
# confidentiality AND integrity of the whole system (F1 + F2). In v2 the Pi holds
# a signing key and a PUBLIC encryption key. It can write records; it cannot read
# the register.

# ------------------------------------------------------------ device identity --
KEY_PROVIDER=file
# Must match a row in device_registry (§20.3 step 3).
DEVICE_ID=<uuid>
# FileKeyProvider only. This is PLAINTEXT ON AN SD CARD and that is a KNOWN,
# ACCEPTED weakness for this phase (F1). The mitigation is not the key store — it
# is the per-batch enrolment quota (§12.6), a database CHECK that bounds what a
# stolen key can do to the remaining quota of one open batch.
DEVICE_PRIVATE_KEY=<64 hex chars>

# ------------------------------------------------------------------ recipient --
# PUBLIC KEY ONLY. The Pi seals records TO the backend and cannot open them.
FIELD_RECIPIENT_PUB=<64 hex chars>

# ------------------------------------------------------------------ endpoints --
# Where enrolments are POSTed and where the clock check reads server_time.
BACKEND_URL=https://<app>.onrender.com
# The host written into every tag URL — usually the Cloudflare Worker.
# FIX THIS BEFORE ENROLLING ANY TAG YOU INTEND TO KEEP. It is baked into the
# NDEF record of every tag and cannot be changed once the pack has shipped.
PUBLIC_HOST=<worker>.<subdomain>.workers.dev

# A batch:read / batch:write token, minted offline with
# backend/scripts/mint_admin_token.py. Needed to open a batch session and to run
# `drainer.py --reconcile`. Not needed for enrolment itself, which authenticates
# with the device signing key alone.
ADMIN_TOKEN=

# -------------------------------------------------------------------- counter --
# NO DEFAULT ON PURPOSE. Run `python enroller.py --calibrate` on a scrap tag
# (§6.4, §20.7) and record the answer here AND in backend/.env. If the two
# disagree, every enrolment records a wrong enrol_counter and the velocity bound
# is nonsense — a silent, hard-to-debug failure. Both sides refuse to start
# without it.
CNT_BYTE_ORDER=

# --------------------------------------------------------------- originality --
# FROM NXP APPLICATION NOTE AN11350. DO NOT INVENT THIS VALUE.
# If it is absent, originality.py returns UNAVAILABLE, the enrolment proceeds,
# and the record is stored with originality_status='unverified' — visible in the
# admin console and in /health. IT MUST NEVER SILENTLY REPORT 'verified'.
NXP_ORIGINALITY_PUBKEY=

# reject (default) | warn. `warn` is for bring-up on known-good stock only.
# A RUN of failures means your supplier shipped counterfeit silicon — that is a
# procurement alert, and discovering it at packaging time is exactly the point.
ORIGINALITY_POLICY=reject

# ------------------------------------------------------------------- locking --
# false for this build phase (decision D5). Tags stay rewritable, and the counter
# and mirror STILL WORK FULLY — they are independent of locking (§6.7).
# Setting this true also requires --i-understand-this-is-permanent on the command
# line, because every step of the lock sequence is IRREVERSIBLE.
TAG_LOCK_ENABLED=false
# Only used when locking is enabled. Diversified per tag from this + the UID, so
# one tag's password is useless against another.
TAG_PWD_MASTER=<64 hex chars>

# -------------------------------------------------------------------- outbox --
# The durable queue written BEFORE any network call (§12.3). WAL mode,
# synchronous=FULL. A pack that ships while its record is lost to an unflushed
# page cache is the exact failure this fixes.
OUTBOX_PATH=./outbox.db

# ---------------------------------------------------------------- NFC timing --
# CARRIED OVER FROM v1 VERBATIM. Writing ~24 pages back-to-back without pacing
# causes real "Response frame preamble does not contain 0x00FF!" I2C errors on
# this hardware. Found empirically. Do not "clean it up".
NDEF_PAGE_WRITE_DELAY=0.05
NDEF_PAGE_WRITE_RETRIES=3

# ---------------------------------------------------------------------------
# REMOVED IN v2 (§21.4): SHARED_SECRET, AES_MASTER_KEY, PI_PRIVATE_KEY (renamed
# to DEVICE_PRIVATE_KEY), FRONTEND_VERIFY_BASE_URL, SHELF_LIFE_DAYS (comes from
# the batch now), QR_FALLBACK_DIR (the QR fallback is gone — F4, §12.2).
# ---------------------------------------------------------------------------
